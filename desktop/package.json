{
  "name": "night-city-broadcaster",
  "productName": "Night City Broadcaster",
  "version": "1.1.0",
  "description": "Webcam board tracking and streaming companion",
  "author": "Night City Broadcaster",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.nightcity.broadcast",
    "files": [
      "main.cjs",
      "package.json",
      "port.cjs",
      "user-data.cjs",
      "update-check.cjs",
      "startup.html"
    ],
    "extraResources": [
      {
        "from": "backend/ncb-server",
        "to": "backend"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      }
    ],
    "directories": {
      "output": "build/packages"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "maintainer": "Night City Broadcaster",
      "artifactName": "Night City Broadcaster-1.1.0.AppImage"
    },
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "afterAllArtifactBuild": "./publish-releases.cjs",
    "portable": {
      "artifactName": "Night City Broadcaster-1.1.0-Windows.exe",
      "splashImage": "assets/portable-splash.bmp"
    },
    "beforePack": "./check-backend.cjs"
  },
  "homepage": "http://127.0.0.1:8766",
  "license": "GPL-3.0-only"
}
